# ══════════════════════════════════════════════════════════════════════
#  Urban Goodz — production environment
#  Copy to .env and fill in. NOTHING here is exposed to the browser except
#  variables prefixed VITE_, which are build-time public by design.
# ══════════════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Lead pipeline wiring ──────────────────────────────────────────────
# Comma-separated, tried in order. Any one succeeding counts as stored.
#   google-sheets | airtable | webhook | console
LEAD_STORAGE=google-sheets

#   hubspot | salesforce | none
LEAD_CRM=none

#   resend | smtp | none
LEAD_EMAIL=smtp

# Comma-separated: ga4 | webhook | console
LEAD_ANALYTICS=ga4

# Who gets the "New Urban Goodz Signup" email (comma-separated).
LEAD_ADMIN_EMAILS=hello@urbangoodzdelivery.com

# Verified sender for outbound mail.
LEAD_FROM_EMAIL=hello@urbangoodzdelivery.com
LEAD_FROM_NAME=Urban Goodz

# ─── Google Sheets ─────────────────────────────────────────────────────
# Create a service account, enable the Sheets API, then share the sheet with
# the service-account email as an Editor.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full PEM. \n escapes are handled automatically.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── CRM ───────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=

# ─── Airtable (alternative storage) ────────────────────────────────────
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Leads

# ─── Email ─────────────────────────────────────────────────────────────
# Option A — transactional API.
RESEND_API_KEY=

# Option B — your own SMTP relay (LEAD_EMAIL=smtp).
# These are the same values your other systems use to send mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
#   tls = implicit TLS (port 465) | starttls = upgrade on 587/25 | none = plaintext
SMTP_ENCRYPTION=starttls
# Only for internal relays with self-signed certificates.
SMTP_ALLOW_INSECURE_TLS=false

# ─── Analytics ─────────────────────────────────────────────────────────
# Server-side GA4 Measurement Protocol.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Generic outbound webhook — usable as storage and/or analytics.
LEAD_WEBHOOK_URL=

# ─── Reliability ───────────────────────────────────────────────────────
LEAD_QUEUE_DIR=.queue
LEAD_RETRY_ATTEMPTS=3
LEAD_RETRY_BASE_MS=400
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_MS=600000

# ─── Privacy ───────────────────────────────────────────────────────────
# Store the submitter's IP in the lead record. Leave false unless your privacy
# policy and jurisdiction permit it.
LEAD_STORE_IP=false

# ─── App store links (public, build-time) ──────────────────────────────
# Leave empty until the apps are live; buttons route to the waitlist instead.
VITE_APP_STORE_URL=
VITE_GOOGLE_PLAY_URL=

# ─── Reserved for future services ──────────────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# DATABASE_URL=
